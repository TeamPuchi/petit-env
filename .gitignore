# コンポーネントリポジトリ(scripts/sync-repos.shが展開する。git管理しない)
/repos/*
!/repos/.gitkeep

# 焼き込み用に展開したコンポーネント(scripts/vendor-components.sh)。
# 🔴 private リポ(m5-petit-app・petit-sns)の中身なので絶対にコミットしない(petit-env は public)
/vendor/*
!/vendor/.gitkeep
/.cache/
/dist/

# ローカル設定
.env

# キャラクターデータ・記憶・ログ(本番データを絶対にコミットしない)
petit-data/
*.db
*.sqlite3

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# エディタ
.vscode/
.idea/
