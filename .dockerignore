# build context に載せないもの。
#
# docker-compose.yml の `context: .` はリポジトリ全体を daemon に送るため、
# .dockerignore が無いと repos/(uv sync 後は .venv 込みで数GB)と .env(秘密)が毎回載る。
# Dockerfile.core は `COPY . .` をしていない(cron/ と scripts/ の5ファイルだけ)ので
# イメージには元から焼き込まれないが、転送そのものを避ける。
#
# T4(K14): 焼き込むコンポーネントは repos/ ではなく vendor/(scripts/vendor-components.sh が
# components.lock の固定 SHA から作る)から渡す。repos/ は dev のバインドマウント専用のまま除外する。

# git
.git
.gitignore

# コンポーネント本体(scripts/sync-repos.sh が展開する。イメージには焼き込まない)
repos/

# vendor-components.sh の取得キャッシュ・束(vendor/ 自体は context に載せる)
.cache/
dist/

# 秘密
.env

# 本番データ・記憶(絶対に context に載せない)
petit-data/
*.db
*.sqlite3

# ドキュメント・配布物(コンテナの中では使わない)
docs/
release/

# 言語ランタイムの生成物
**/.venv/
**/__pycache__
**/node_modules

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/
